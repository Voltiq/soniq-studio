{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soniq Studio",
  "version": "0.1.0",
  "identifier": "app.soniq.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soniq Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0D0E11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Voltiq",
    "copyright": "© 2026 Voltiq",
    "category": "Music",
    "homepage": "https://github.com/Voltiq/soniq-studio",
    "shortDescription": "Audio editor and music production workstation",
    "longDescription": "Soniq Studio records, edits and produces music and audio: an audio editor, a timeline and clip launcher, instruments and effects, plugins, podcast tools and loudness metering in one app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMUZBQ0Q1OTgwMzlGRUMKUldUc253T1kxYXdmNHNkVHhmQ0ZocEJPZ1lyazgvZUFodDcxUzJQWVp3VGlSNXZad3lyZDF6TDkK",
      "endpoints": [
        "https://github.com/Voltiq/soniq-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
